      "post": {
        "tags": [
          "Images"
        ],
        "summary": "Upload images",
        "description": "Upload one or more images to a collection. `target_collection_id` can be a collection UUID or `DEFAULT`. Duplicate detection may be applied depending on configuration.",
        "operationId": "upload_images__post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_collection_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "const": "DEFAULT",
                  "type": "string"
                }
              ],
              "description": "Target collection ID or `DEFAULT` for the user's default collection.",
              "default": "DEFAULT",
              "title": "Target Collection Id"
            },
            "description": "Target collection ID or `DEFAULT` for the user's default collection."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_images__post"
              }
            }
